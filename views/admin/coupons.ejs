<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="section admin">
  <div class="container admin-layout">
    <%- include('sidebar') %>

    <div class="admin-content">
      <h1 class="admin-title">Discount Codes</h1>

      <form class="card coupon-form" method="post" action="/admin/coupons">
        <div class="three-col">
          <label>Code
            <input type="text" name="code" required placeholder="SUMMER20" style="text-transform:uppercase">
          </label>
          <label>Type
            <select name="type">
              <option value="percent">Percent off (%)</option>
              <option value="fixed">Fixed amount ($)</option>
            </select>
          </label>
          <label>Value
            <input type="number" name="value" min="0.01" step="0.01" required placeholder="20">
          </label>
        </div>
        <button type="submit" class="btn btn-gold">+ Create Code</button>
      </form>

      <% if (coupons.length === 0) { %>
        <p class="muted">No discount codes yet.</p>
      <% } else { %>
        <table class="table card">
          <thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <% coupons.forEach(function(c){ %>
              <tr>
                <td><strong><%= c.code %></strong></td>
                <td><%= c.type === 'percent' ? 'Percent' : 'Fixed' %></td>
                <td><%= c.type === 'percent' ? c.value + '%' : '$' + c.value.toFixed(2) %></td>
                <td><span class="status <%= c.active ? 'status-delivered' : 'status-cancelled' %>"><%= c.active ? 'active' : 'inactive' %></span></td>
                <td class="actions">
                  <form method="post" action="/admin/coupons/<%= c.id %>/toggle" class="inline-form">
                    <button class="btn btn-small btn-outline"><%= c.active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                  <form method="post" action="/admin/coupons/<%= c.id %>/delete" class="inline-form"
                        onsubmit="return confirm('Delete code <%= c.code %>?')">
                    <button class="btn btn-small btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
