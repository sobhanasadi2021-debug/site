</main>
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <h3 class="footer-logo"><%= settings.storeName.split(' ')[0] %> <span><%= settings.storeName.split(' ').slice(1).join(' ') %></span></h3>
      <p><%= t.footer_blurb %></p>
    </div>
    <div>
      <h4><%= t.footer_shop %></h4>
      <% categories.forEach(function(cat){ %>
        <a href="/category/<%= cat.slug %>"><%= lang === 'fa' ? cat.name_fa : cat.name %></a>
      <% }) %>
    </div>
    <div>
      <h4><%= t.footer_maison %></h4>
      <a href="/about"><%= t.nav_maison %></a>
      <a href="/faq"><%= t.client_care %></a>
      <a href="/contact"><%= t.nav_contact %></a>
      <a href="/shop"><%= t.collection_link %></a>
    </div>
    <div>
      <h4><%= t.footer_atelier %></h4>
      <p><%= settings.addressLine %></p>
      <p><%= settings.email %><br><%= settings.phone %></p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 <%= settings.storeName %>. <%= t.footer_rights %></p>
  </div>
</footer>
<script src="/js/main.js"></script>
</body>
</html>
