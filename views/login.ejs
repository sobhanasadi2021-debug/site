<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="section">
  <div class="container auth-wrap">
    <form class="auth-card card" method="post" action="/login">
      <p class="eyebrow center"><%= t.members_only %></p>
      <h1 class="section-title"><%= t.sign_in %></h1>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>
      <input type="hidden" name="next" value="<%= next %>">
      <label><%= t.email %><input type="email" name="email" required placeholder="you@example.com"></label>
      <label><%= t.password %><input type="password" name="password" required placeholder="••••••••"></label>
      <button type="submit" class="btn btn-gold btn-wide"><%= t.enter_maison %></button>
      <p class="auth-alt"><%= t.new_here %> <a href="/register"><%= t.create_account_link %></a></p>
      <div class="demo-creds">
        <p><strong><%= t.demo_accounts %></strong></p>
        <p>Admin — admin@maisonnoir.com / admin123</p>
        <p>Customer — customer@maisonnoir.com / customer123</p>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
